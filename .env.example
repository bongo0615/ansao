# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Chuyên gia luận giải dùng Claude Opus 5. Thiếu key → khung chat báo tắt,
# phần lập lá số vẫn chạy bình thường.
# Lấy tại https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Tuỳ chọn phát triển ─────────────────────────────────────────────────────
# Chế độ khách: bỏ qua đăng nhập, lá số lưu trong localStorage. Dùng để kiểm
# thử engine + giao diện. Đặt 1 để bật; 0 hoặc bỏ trống = luồng Supabase.
NEXT_PUBLIC_CHE_DO_KHACH=0
