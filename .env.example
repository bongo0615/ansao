# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Chuyên gia luận giải dùng Claude Opus 5. Thiếu key → khung chat báo tắt,
# phần lập lá số vẫn chạy bình thường.
# Lấy tại https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Tuỳ chọn phát triển ─────────────────────────────────────────────────────
# Chế độ khách: bỏ qua đăng nhập, lá số lưu trong localStorage. Dùng để kiểm
# thử engine + giao diện. Đặt 1 để bật; 0 hoặc bỏ trống = luồng Supabase.
NEXT_PUBLIC_CHE_DO_KHACH=0

# Cho hỏi chuyên gia mà không cần đăng nhập (demo). Hạn mức 15 lượt/giờ mỗi IP.
# ⚠️ Đây là endpoint gọi LLM mở cho người lạ — TẮT (0) trước khi phát hành rộng.
NEXT_PUBLIC_CHAT_MO=0

# Cho tự đăng ký tài khoản. TẮT trong giai đoạn thử nghiệm.
# ⚠️ Chỉ ẩn giao diện — chốt chặn thật ở Supabase:
#    Authentication → Sign In / Providers → Email → tắt "Allow new users to sign up".
NEXT_PUBLIC_CHO_DANG_KY=0
