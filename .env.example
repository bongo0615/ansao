# Chế độ khách: bỏ qua đăng nhập, lá số lưu trong localStorage của trình duyệt.
# Dùng để kiểm thử engine + giao diện. Đặt 0 hoặc xoá để bật lại đăng nhập.
NEXT_PUBLIC_CHE_DO_KHACH=0
