# Supabase — lấy ở Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dùng cho tác vụ quản trị phía server (tuỳ chọn)
