# ─── Tên miền ────────────────────────────────────────────────────────────────
# Chỉ hostname, không có scheme. Caddy dùng để xin chứng chỉ Let's Encrypt.
# Bản ghi A của tên miền phải trỏ về IP tĩnh của VM TRƯỚC khi khởi động.
DOMAIN=ansao.example.com

# ─── Supabase ────────────────────────────────────────────────────────────────
# ⚠️ Hai biến NEXT_PUBLIC_* được nhúng vào bundle LÚC BUILD. Đổi giá trị thì
# phải chạy lại build-local.sh, sửa ở đây rồi restart là KHÔNG ăn thua.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng phía server (tạo tài khoản, tác vụ quản trị). Bỏ trống nếu chưa cần.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Chuyên gia luận giải dùng Claude Opus 5. Thiếu key → khung chat báo tắt,
# phần lập lá số vẫn chạy bình thường.
ANTHROPIC_API_KEY=

# ─── Địa chỉ site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ansao.example.com

# ─── Cờ tính năng (đều là NEXT_PUBLIC — nhúng lúc build) ─────────────────────
# Chế độ khách: bỏ qua đăng nhập, lá số lưu trong trình duyệt. Production để 0.
NEXT_PUBLIC_CHE_DO_KHACH=0
# Cho hỏi chuyên gia không cần đăng nhập. ⚠️ Mở endpoint LLM cho người lạ.
NEXT_PUBLIC_CHAT_MO=0
# Cho tự đăng ký tài khoản. Nhớ tắt CẢ ở Supabase (Auth → Email → Allow signup).
NEXT_PUBLIC_CHO_DANG_KY=0
